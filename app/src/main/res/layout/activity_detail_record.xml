<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".views.DetailRecordActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Detalle del Registro"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="?attr/colorOnPrimary"
            android:background="?attr/colorPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fotografía principal con esquinas redondeadas modernas -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_detail_photo"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_camera_placeholder"
                android:background="@color/color_photo_placeholder_bg"
                android:contentDescription="Fotografía del registro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Título -->
                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Inspección de Parcela Norte"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Fecha y Hora con icono -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="?attr/colorOutline"
                        android:contentDescription="Icono fecha" />

                    <TextView
                        android:id="@+id/tv_detail_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        tools:text="24 de Octubre de 2026, 10:30 AM"
                        android:textSize="13.5sp"
                        android:textColor="?attr/colorOutline" />

                </LinearLayout>

                <!-- Divisor sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginVertical="18dp" />

                <!-- Encabezado Descripción -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Texto de Descripción -->
                <TextView
                    android:id="@+id/tv_detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Se observó buena germinación en los surcos 1 al 12. La humedad relativa se mantiene favorable y no se registran indicios de plagas en el follaje."
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="10dp" />

                <!-- Botón Editar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_detail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Editar Registro"
                    android:textSize="14.5sp"
                    android:layout_marginTop="28dp"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconSize="18dp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:cornerRadius="14dp" />

                <!-- Botón Eliminar Estilizado -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_detail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Eliminar Registro"
                    android:textSize="14.5sp"
                    android:layout_marginTop="12dp"
                    app:icon="@drawable/ic_trash"
                    app:iconSize="18dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="?attr/colorError"
                    android:textColor="?attr/colorError"
                    app:iconTint="?attr/colorError"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Indicador de Carga -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
