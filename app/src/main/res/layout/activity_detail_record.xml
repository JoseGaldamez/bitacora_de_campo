<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".views.DetailRecordActivity">

    <!-- App Bar moderna -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:liftOnScroll="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="Detalle del Registro"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Contenedor Hero de la Fotografía -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurface">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_detail_photo"
                    android:layout_width="match_parent"
                    android:layout_height="270dp"
                    android:scaleType="fitCenter"
                    android:padding="52dp"
                    android:src="@drawable/ic_camera_placeholder"
                    android:background="@color/color_photo_hero_bg"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Large"
                    android:contentDescription="Fotografía del registro" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Área de Información del Registro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="40dp">

                <!-- Título -->
                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Inspección de Cuadrante Este"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="2dp" />

                <!-- Badge de Fecha y Hora -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_badge_date">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Icono de fecha" />

                    <TextView
                        android:id="@+id/tv_detail_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        tools:text="24 de Octubre de 2026, 10:30 AM"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <!-- Divisor Sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp" />

                <!-- Sección de Descripción -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OBSERVACIONES Y NOTAS"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Se observó buena germinación en los surcos 1 al 12. La humedad relativa se mantiene favorable y no se registran indicios de plagas en el follaje."
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="10dp" />

                <!-- Botón Eliminar Estilizado -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_detail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Eliminar Registro"
                    android:textSize="14.5sp"
                    android:layout_marginTop="36dp"
                    app:icon="@drawable/ic_trash"
                    app:iconSize="18dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="?attr/colorError"
                    android:textColor="?attr/colorError"
                    app:iconTint="?attr/colorError"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Indicador de Carga -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
