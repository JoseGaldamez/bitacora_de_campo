<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark). -->
    <style name="Base.Theme.Bitacora_de_campo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">#7ED4A0</item>
        <item name="colorOnPrimary">#00381F</item>
        <item name="colorPrimaryContainer">#164531</item>
        <item name="colorOnPrimaryContainer">#B4F3CC</item>
        <item name="colorSecondary">#B2C9B9</item>
        <item name="colorOnSecondary">#1D3528</item>
        <item name="colorSecondaryContainer">#344B3D</item>
        <item name="colorOnSecondaryContainer">#CEE5D4</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:colorBackground">@color/color_background_dark</item>
        <item name="colorSurface">@color/color_surface_dark</item>
        <item name="colorOnSurface">@color/color_on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant_dark</item>
        <item name="colorOutline">@color/color_outline_dark</item>
        <item name="colorOutlineVariant">@color/color_outline_variant_dark</item>

        <!-- Error Colors -->
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Component Shape Theming -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
    </style>

    <!-- Elevated / Clean Card Style -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_outline_variant_dark</item>
        <item name="cardBackgroundColor">@color/color_surface_dark</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/color_outline_variant_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
